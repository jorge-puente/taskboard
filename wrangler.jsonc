{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskboard",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-29",

  "vars": {
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbyS0TrFcBONxMzlu5MgnDtv69jNjjJgGXy2X-o_qdZFz_tZtr8niNyECyqnxMGgo1A/exec"
  },

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  }
}
